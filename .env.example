# Change Liberia - Environment Variables Configuration
# Local dev defaults. For production, set NODE_ENV=production, strong JWT_SECRET,
# CORS_ORIGIN=https://your-frontend-host, ID_DOCUMENT_PUBLIC_BASE_URL=https://your-api-host,
# ENABLE_SWAGGER=false, and real credentials on the platform (not in git).

# ============================================================================
# DATABASE CONFIGURATION (Supabase Postgres)
# ============================================================================
# DATABASE_URL: the app's runtime connection, via Supabase's Transaction pooler
# (port 6543, pgbouncer=true). Required for serverless/Vercel deployments —
# don't open direct connections from short-lived functions.
# Find both strings in Supabase Dashboard -> Project Settings -> Database.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: a direct (non-pooled) connection, port 5432. Prisma Migrate needs
# this to run schema migrations — pgbouncer's transaction mode doesn't support
# the prepared statements/advisory locks migrations rely on.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# For local dev against docker-compose's local Postgres instead of Supabase,
# point both vars at the same non-pooled connection:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verified_liberian_voices"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/verified_liberian_voices"

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET="super-secret"
JWT_EXPIRES_IN="7d"

# ============================================================================
# GOOGLE OAUTH INTEGRATION
# ============================================================================
# Get credentials from https://console.cloud.google.com
# 1. Create OAuth 2.0 Client ID (Web application type)
# 2. Add authorized redirect URI: http://localhost:3001/auth/google/callback
# 3. Copy Client ID and Client Secret below
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:3001/auth/google/callback"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""  # Same as GOOGLE_OAUTH_CLIENT_ID, used by frontend

# ============================================================================
# VERIFICATION & CAPTCHA
# ============================================================================
OTP_PROVIDER="mock"
CAPTCHA_PROVIDER="mock"
TURNSTILE_SECRET_KEY=""
HCAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ============================================================================
# FRAUD DETECTION
# ============================================================================
FRAUD_RISK_ALERT_THRESHOLD="0.35"

# ============================================================================
# SMS/NOTIFICATIONS (Twilio)
# ============================================================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ============================================================================
# STRIPE INTEGRATION (Phase 12.1)
# ============================================================================
STRIPE_API_KEY="sk_test_"
STRIPE_WEBHOOK_SECRET="whsec_test_"

# ============================================================================
# EMAIL CONFIGURATION (Phase 12.3)
# ============================================================================
EMAIL_PROVIDER="development"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@liberianvoices.org"
EMAIL_REPLY_TO="support@liberianvoices.org"

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
API_URL_INTERNAL="http://api:4000/api/v1"

# ============================================================================
# CORS & APPLICATION
# ============================================================================
CORS_ORIGIN="http://localhost:3000"
ID_DOCUMENT_PUBLIC_BASE_URL="http://localhost:4000"
APP_URL="http://localhost:4000"

# ============================================================================
# SUPABASE REALTIME (client-side, replaces the old Socket.IO gateways)
# ============================================================================
# Public/anon values — safe to expose to the browser. Dashboard -> Project
# Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ============================================================================
# SUPABASE STORAGE (ID documents, petition media, CMS files)
# ============================================================================
# Server-side only — the service role key bypasses Row Level Security and
# must never be exposed to the web app (no NEXT_PUBLIC_ prefix, ever).
# Dashboard -> Project Settings -> API.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Create these buckets once in Supabase Dashboard -> Storage:
#   id-documents   (private)
#   petition-media (public)
#   cms-files      (public)

# ============================================================================
# CRON (Vercel Cron -> /api/v1/internal/cron/*, see vercel.json)
# ============================================================================
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on
# scheduled requests when this is set as a project env var. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ============================================================================
# DOCUMENTATION
# ============================================================================
ENABLE_SWAGGER="true"

# ============================================================================
# FILE UPLOADS
# ============================================================================
ID_DOCUMENT_UPLOAD_DIR=""

# ============================================================================
# FACEBOOK INTEGRATION (Phase 8)
# ============================================================================
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PIXEL_ID=""

# ============================================================================
# ENVIRONMENT NOTES
# ============================================================================
# Development: Use test keys, mock providers
# Production: Use live keys, real SMTP/SendGrid, enable rate limiting
# Staging: Test with real integrations, monitor logs
